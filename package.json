{
  "name": "precision-speed-monitor",
  "version": "1.0.0",
  "description": "Real-time internet speed monitor edge widget",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.precision.monitor",
    "productName": "Precision Monitor",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist_build"
    }
  },
  "keywords": [
    "network",
    "speed",
    "electron"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "chart.js": "^4.5.1",
    "systeminformation": "^5.31.5"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^24.13.3"
  }
}
